rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- RATE LIMITING HELPERS ----------
    // Client-direct writes (creating a listing, sending a chat message) have
    // no server in front of them to throttle, so the cooldown itself has to
    // live in these rules: each action reads the user's own userLimits doc
    // and refuses the write if it happened too recently. The write that
    // records the new timestamp is a separate write in the SAME batch (see
    // AddPartForm.tsx / ChatView.tsx), validated below by the userLimits
    // rules so a client can't just claim an old timestamp to dodge this.
    function listingCooldownPassed() {
      let path = /databases/$(database)/documents/userLimits/$(request.auth.uid);
      return !exists(path) ||
             !('lastListingCreatedAt' in get(path).data) ||
             request.time.toMillis() - get(path).data.lastListingCreatedAt.toMillis() >= 30000;
    }

    function messageCooldownPassed() {
      let path = /databases/$(database)/documents/userLimits/$(request.auth.uid);
      return !exists(path) ||
             !('lastMessageAt' in get(path).data) ||
             request.time.toMillis() - get(path).data.lastMessageAt.toMillis() >= 2000;
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && userId == request.auth.uid;

      // Owner can update their own profile, but NOT their own wallet balance.
      // Only admin (via approved refill_requests) can change simulatedCredits.
      allow update: if isSignedIn() && (
                      (userId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['simulatedCredits', 'uid'])
                      ) || isAdmin()
                    );
      allow delete: if isAdmin();
    }

    // ---------- ADMINS ----------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- LISTINGS ----------
    match /listings/{listingId} {
      allow read: if true;

      allow create: if isSignedIn() &&
                    request.resource.data.sellerId == request.auth.uid &&
                    request.resource.data.price is number &&
                    request.resource.data.price >= 0 &&
                    request.resource.data.price <= 99999999 &&
                    request.resource.data.title is string &&
                    request.resource.data.title.size() > 0 &&
                    request.resource.data.title.size() < 200 &&
                    request.resource.data.description is string &&
                    request.resource.data.description.size() < 3000 &&
                    listingCooldownPassed();

      // Owner can edit their listing but cannot self-promote (isAd/adTier/etc are admin-only).
      allow update: if isSignedIn() && (
                      (resource.data.sellerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                         ['createdAt', 'sellerId', 'isAd', 'adTier', 'adDurationDays', 'adExpiresAt']
                       )
                      ) || isAdmin()
                    );

      // Anyone (logged in or an anonymous visitor) may bump views by exactly +1
      // (view-count analytics on opening a listing). Not gated behind isSignedIn()
      // so visitors who never log in still count as a view -- capped to +1 per
      // request so it can't be abused to inflate the counter arbitrarily.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
                    request.resource.data.views == (resource.data.views is number ? resource.data.views : 0) + 1;

      // Any signed-in user may bump clicks by exactly +1.
      allow update: if isSignedIn() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) &&
                    request.resource.data.clicks == (resource.data.clicks is number ? resource.data.clicks : 0) + 1;

      // Hard delete is admin-only now. Sellers "delete" their own listing by
      // setting isDeleted/deletedAt via the update rule above instead --
      // that's a soft delete with a 30-day recovery window, permanently
      // purged later by /api/cron/data-retention-cleanup (Admin SDK, bypasses
      // these rules entirely, so no rule is needed for that job itself).
      allow delete: if isAdmin();

      // ---------- DISTRIBUTED VIEW/SAVE COUNTER SHARDS ----------
      // Instead of writing "views"/a save-count directly onto the listing
      // document (which only reliably sustains ~1 write/second), each
      // increment goes to one of several small shard documents chosen at
      // random. A scheduled job (Admin SDK, bypasses these rules) sums the
      // shards and refreshes listing.views / listing.savedCount every few
      // minutes. Clients never read shard docs directly, only the admin
      // aggregation job does, so read is locked down entirely.
      match /counterShards/{shardId} {
        allow read: if false;

        // First write to a shard: bootstrapping either counter at exactly 1.
        allow create: if (request.resource.data.keys().hasOnly(['views']) &&
                           request.resource.data.views == 1) ||
                          (isSignedIn() &&
                           request.resource.data.keys().hasOnly(['saved']) &&
                           request.resource.data.saved == 1);

        // Subsequent writes: bump exactly one of the two counters by exactly
        // +/-1 (views: visitors only ever add; saved: signed-in users can
        // add when saving or subtract when un-saving).
        allow update: if (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
                        request.resource.data.views == (resource.data.views is number ? resource.data.views : 0) + 1
                      ) || (
                        isSignedIn() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saved']) &&
                        (
                          request.resource.data.saved == (resource.data.saved is number ? resource.data.saved : 0) + 1 ||
                          request.resource.data.saved == (resource.data.saved is number ? resource.data.saved : 0) - 1
                        )
                      );

        allow delete: if false;
      }
    }

    // ---------- RATE LIMIT TRACKING (one doc per user) ----------
    // Written in the same batch as the action it's timestamping (see
    // AddPartForm.tsx, ChatView.tsx) so the two either both succeed or both
    // fail together. Only the field being changed right now is required to
    // equal request.time -- otherwise re-saving one field would also force
    // an untouched older timestamp on the other field to magically become
    // "now", which would silently defeat that field's own cooldown.
    match /userLimits/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn() && request.auth.uid == uid &&
                    request.resource.data.keys().hasOnly(['lastListingCreatedAt', 'lastMessageAt']) &&
                    (!('lastListingCreatedAt' in request.resource.data) || request.resource.data.lastListingCreatedAt == request.time) &&
                    (!('lastMessageAt' in request.resource.data) || request.resource.data.lastMessageAt == request.time);

      allow update: if isSignedIn() && request.auth.uid == uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastListingCreatedAt', 'lastMessageAt']) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastListingCreatedAt']) || request.resource.data.lastListingCreatedAt == request.time) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageAt']) || request.resource.data.lastMessageAt == request.time);

      allow delete: if false;
    }

    // ---------- REFILL / AD-PROMOTION REQUESTS ----------
    match /refill_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.amount is number &&
                    request.resource.data.amount > 0;
      allow update, delete: if isAdmin();
    }

    // ---------- PURCHASES (order records, immutable after creation) ----------
    match /purchases/{purchaseId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- SELLER REVIEWS ----------
    match /seller_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
                    request.resource.data.reviewerId == request.auth.uid &&
                    request.resource.data.sellerId is string &&
                    request.resource.data.comment is string &&
                    request.resource.data.comment.size() < 1000 &&
                    request.resource.data.rating is number &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5;
      allow update, delete: if isSignedIn() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // ---------- CHATS ----------
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() &&
                    (request.auth.uid in resource.data.participants) &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
                    (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isSignedIn() &&
                      (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) &&
                      request.resource.data.senderId == request.auth.uid &&
                      messageCooldownPassed();
        allow update, delete: if isAdmin();
      }
    }

    // ---------- LOTTERY DRAWS (free daily "Boost Ads" lottery, server-only writes) ----------
    // Draws are only ever created by the /api/lottery/draw serverless function (Admin SDK),
    // which bypasses these rules — this keeps the win chance and daily limit tamper-proof.
    match /lottery_draws/{drawId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---------- SUPPORT TICKETS (guests can also submit) ----------
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
                    (!isSignedIn() && request.resource.data.userId == "guest");
      allow update, delete: if isAdmin();
    }

    // ---------- SITE VISIT / LOGIN / SIGNUP ANALYTICS ----------
    // Written only by the /api/track-event serverless function (Admin SDK),
    // which bypasses these rules -- keeps visitor IP/location data from
    // being writable or readable by anyone except an admin.
    match /site_visits/{visitId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /analytics_stats/{statId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sharded counter sub-documents (analytics_stats/summary/shards/{0-9}).
    // Firestore rules don't recurse into subcollections automatically, so
    // this needs its own match block for the admin panel's client-side read.
    match /analytics_stats/{statId}/shards/{shardId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Everything else: locked down ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
