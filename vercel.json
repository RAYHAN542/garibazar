{
  "redirects": [
    { "source": "/download", "destination": "https://play.google.com/store/apps/details?id=shop.garibazar.twa&referrer=utm_source%3Dwebsite%26utm_medium%3Ddownload_link", "permanent": false }
  ],
  "rewrites": [
    { "source": "/l/:id", "destination": "/api/share-listing?id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/guides", "destination": "/guides.html" },
    { "source": "/guides/used-car-checklist", "destination": "/guide-used-car.html" },
    { "source": "/guides/car-battery-guide", "destination": "/guide-battery.html" },
    { "source": "/guides/fake-motorcycle-parts", "destination": "/guide-fake-parts.html" },
    { "source": "/guides/engine-oil-guide", "destination": "/guide-engine-oil.html" },
    { "source": "/guides/tyre-buying-guide", "destination": "/guide-tyre.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/downloads/(.*).apk",
      "headers": [
        {"key": "Content-Type", "value": "application/vnd.android.package-archive"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: ; connect-src 'self' https: wss://*.supabase.co; frame-src 'self' https:; form-action 'self' https://pay.bkash.com https://api.nagad.com.bd; frame-ancestors 'self'; base-uri 'self'; object-src 'none';"}
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 2 * * *"
    }
  ]
}
